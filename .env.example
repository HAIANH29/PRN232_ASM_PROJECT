POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
JWT_SIGNING_KEY=development-only-replace-with-secret
# The public development key is accepted only for the local demo. For any real deployment set a private key of 32+ characters and JWT_ALLOW_DEVELOPMENT_KEY=false.
JWT_ALLOW_DEVELOPMENT_KEY=true
# Shared secret between Meal Planning and the Notification Worker (internal reminder check).
INTERNAL_API_KEY=development-only-internal-key
IDENTITY_ADMIN_EMAIL=admin@longevity.local
IDENTITY_ADMIN_PASSWORD=Admin@123456
IDENTITY_ADMIN_DISPLAY_NAME=Demo Admin
IDENTITY_USER_EMAIL=user@longevity.local
IDENTITY_USER_PASSWORD=User@123456
IDENTITY_USER_DISPLAY_NAME=Demo User
DIET_KNOWLEDGE_SEED_INCLUDE_DEMO_APPROVED_CONTENT=true
BOOK_KNOWLEDGE_STORAGE_PATH=/app/storage/book-sources
GEMINI_ENABLED=false
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com
GEMINI_API_KEY=development-only
GEMINI_MODEL=gemini-2.0-flash
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=development-only
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Longevity Diet Platform
# Vector database (pgvector) used for semantic search over approved knowledge.
# The embedding model is only used when GEMINI_ENABLED=true and a real key is set; otherwise a local hash embedding is used.
EMBEDDING_MODEL=gemini-embedding-001
KNOWLEDGE_INDEX_ON_STARTUP=true
