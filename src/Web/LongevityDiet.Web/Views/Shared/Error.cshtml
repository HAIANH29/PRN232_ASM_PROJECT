@model ErrorViewModel
@{
    ViewData["Title"] = T["Something went wrong"];
}

<section class="section-card error-card">
    <div class="error-icon"><span class="icon" aria-hidden="true">error</span></div>
    <p class="eyebrow">@T["Error"]</p>
    <h1>@T["Something went wrong"]</h1>
    <p class="text-muted">@T["An error occurred while processing your request."]</p>

    @if (Model.ShowRequestId)
    {
        <p class="mb-3">
            <span class="chip-tag neutral">@T["Request ID"]: <code>@Model.RequestId</code></span>
        </p>
    }

    <div class="head-actions justify-content-center">
        <a class="btn btn-dark" asp-controller="Home" asp-action="Index"><span class="icon" aria-hidden="true">home</span>@T["Back to dashboard"]</a>
    </div>
</section>
