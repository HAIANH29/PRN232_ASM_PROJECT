@inject UserSession UserSession
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Longevity Diet Platform</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LongevityDiet.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom app-nav">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Longevity Diet Platform</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Knowledge" asp-action="Index">Knowledge</a>
                        </li>
                        @if (UserSession.IsSignedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="MealPlans" asp-action="Index">Meal Plans</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Recommendations" asp-action="Index">Recommendations</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Tracking" asp-action="Index">Tracking</a>
                            </li>
                        }
                        @if (UserSession.IsAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="AdminKnowledge" asp-action="Index">Admin</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (UserSession.IsSignedIn)
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Auth" asp-action="Profile">@UserSession.DisplayName</a>
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                <button class="btn btn-sm btn-dark" type="submit">Sign out</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Auth" asp-action="Login">Sign in</a>
                            <a class="btn btn-sm btn-dark" asp-controller="Auth" asp-action="Register">Register</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid app-shell">
        <main role="main" class="pb-3">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white">
        <div class="container-fluid">
            &copy; 2026 - Longevity Diet Platform
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
