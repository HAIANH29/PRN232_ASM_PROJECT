@using System.Globalization
@model TrackingIndexViewModel
@{
    ViewData["Title"] = T["Daily check-in"];
    var foodsById = Model.Foods.ToDictionary(food => food.Id);
    var recipesById = Model.Recipes.ToDictionary(recipe => recipe.Id);
    // The Tracking API only counts meals that were already tracked, so the real plan size comes from the plans.
    var plannedInPeriod = Model.MealPlans
        .SelectMany(plan => plan.Items)
        .Count(item => item.PlannedDate >= Model.Form.PeriodStartDate && item.PlannedDate <= Model.Form.PeriodEndDate);
    var plannedTotal = Math.Max(plannedInPeriod, Model.ProgressSummary?.PlannedMeals ?? 0);
    var completedTotal = Model.ProgressSummary?.CompletedMeals ?? 0;
    // The API returns a 0-1 ratio, so convert to a percentage here.
    var completionRate = plannedTotal == 0
        ? 0m
        : Math.Min(100m, Math.Round(completedTotal * 100m / plannedTotal, 0));
    var trackedByItem = (Model.DailyTracking?.Meals ?? Array.Empty<MealTrackingResponse>())
        .ToDictionary(meal => meal.MealPlanItemId);
    var day = Model.Form.TrackingDate;
    var mealsOfDay = Model.MealPlans
        .SelectMany(plan => plan.Items.Select(item => new { Plan = plan, Item = item }))
        .Where(entry => entry.Item.PlannedDate == day)
        .OrderBy(entry => entry.Item.MealSlot == "Breakfast" ? 0 : entry.Item.MealSlot == "Lunch" ? 1 : entry.Item.MealSlot == "Dinner" ? 2 : 3)
        .ToList();
    string NameOf(MealPlanItemResponse item) =>
        item.FoodId.HasValue && foodsById.TryGetValue(item.FoodId.Value, out var food) ? T.C(food.Name)
        : item.RecipeId.HasValue && recipesById.TryGetValue(item.RecipeId.Value, out var recipe) ? T.C(recipe.Name)
        : T["Catalog item"];
    var isToday = day == DateOnly.FromDateTime(DateTime.Today);
}

<section class="page-head">
    <div>
        <p class="eyebrow">@T["Daily check-in"]</p>
        <h1>@(isToday ? T["Today's meals"] : day.ToString("dddd, d MMMM yyyy", Translator.FormatCulture))</h1>
        <p class="text-muted mb-0">@T["Tick off the meals you have eaten from your plan, add a short note, and see how the week is going."]</p>
    </div>
</section>

<form method="get" class="filter-bar">
    <div>
        <label for="trackingDate" class="form-label">@T["Day"]</label>
        <input id="trackingDate" name="trackingDate" type="date" class="form-control" value="@Model.Form.TrackingDate.ToString("yyyy-MM-dd")" />
    </div>
    <div>
        <label for="periodStartDate" class="form-label">@T["Progress from"]</label>
        <input id="periodStartDate" name="periodStartDate" type="date" class="form-control" value="@Model.Form.PeriodStartDate.ToString("yyyy-MM-dd")" />
    </div>
    <div>
        <label for="periodEndDate" class="form-label">@T["Progress to"]</label>
        <input id="periodEndDate" name="periodEndDate" type="date" class="form-control" value="@Model.Form.PeriodEndDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter-actions">
        <button class="btn btn-dark" type="submit">@T["Show"]</button>
    </div>
</form>

<section class="two-pane">
    <div class="section-card">
        <div class="card-heading">
            <h2>@T["Meals planned for this day"]</h2>
            <span class="count-pill">@mealsOfDay.Count</span>
        </div>
        @if (mealsOfDay.Count == 0)
        {
            <p class="empty-state">
                @T["Nothing is planned for this day. Pick another day above, or"]
                <a asp-controller="MealPlans" asp-action="Index">@T["add meals to a plan"]</a>
                @T["(or"] <a asp-controller="Recommendations" asp-action="Index">@T["get meal ideas"]</a>).
            </p>
        }
        else
        {
            <div class="item-stack">
                @foreach (var entry in mealsOfDay)
                {
                    var done = trackedByItem.TryGetValue(entry.Item.Id, out var tracked) && tracked.IsCompleted;
                    <article class="plan-row">
                        <div>
                            <div class="item-title">@T[entry.Item.MealSlot]: @NameOf(entry.Item)</div>
                            <small>@T.F("From plan \"{0}\"", entry.Plan.Name)</small>
                        </div>
                        <form asp-action="SetMeal" method="post" class="inline-form">
                            <input type="hidden" name="Form.TrackingDate" value="@day.ToString("yyyy-MM-dd")" />
                            <input type="hidden" name="Form.PeriodStartDate" value="@Model.Form.PeriodStartDate.ToString("yyyy-MM-dd")" />
                            <input type="hidden" name="Form.PeriodEndDate" value="@Model.Form.PeriodEndDate.ToString("yyyy-MM-dd")" />
                            <input type="hidden" name="Form.MealPlanItemId" value="@entry.Item.Id" />
                            <input type="hidden" name="Form.IsCompleted" value="@((!done).ToString().ToLowerInvariant())" />
                            @if (done)
                            {
                                <span class="badge text-bg-success me-2">@T["Eaten"]</span>
                                <button class="btn btn-sm btn-outline-secondary" type="submit">@T["Undo"]</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-dark" type="submit">@T["Mark as eaten"]</button>
                            }
                        </form>
                    </article>
                }
            </div>
        }
    </div>

    <form asp-action="SaveDaily" method="post" class="section-card form-stack">
        <div class="card-heading">
            <h2>@T["Note for the day"]</h2>
        </div>
        <input asp-for="Form.TrackingDate" type="hidden" />
        <input asp-for="Form.PeriodStartDate" type="hidden" />
        <input asp-for="Form.PeriodEndDate" type="hidden" />
        <div>
            <label asp-for="Form.Notes" class="form-label">@T["How did the day go?"]</label>
            <textarea asp-for="Form.Notes" class="form-control" rows="5" placeholder="@T["Optional - e.g. felt full after lunch, skipped the snack"]"></textarea>
            <span asp-validation-for="Form.Notes" class="text-danger small"></span>
        </div>
        <button class="btn btn-dark" type="submit">@T["Save note"]</button>
    </form>
</section>

<section class="section-card mt-3">
    <div class="card-heading">
        <h2>@T["Your progress"]</h2>
        <span class="badge text-bg-light border">@Model.Form.PeriodStartDate.ToString("d MMM", Translator.FormatCulture) - @Model.Form.PeriodEndDate.ToString("d MMM yyyy", Translator.FormatCulture)</span>
    </div>
    @if (plannedTotal == 0)
    {
        <p class="empty-state">
            @T["No planned meals fall between these dates yet, so there is no progress to show. Change the \"Progress from / to\" dates, or"] <a asp-controller="MealPlans" asp-action="Index">@T["create a meal plan"]</a>.
        </p>
    }
    else
    {
        <div class="progress-stat">
            <strong>@T.F("{0} of {1}", completedTotal, plannedTotal)</strong>
            <span>@T.F("planned meals eaten ({0}%)", completionRate.ToString("0", CultureInfo.InvariantCulture))</span>
        </div>
        <div class="progress mb-3" role="progressbar" aria-label="@T["Completion rate"]" aria-valuenow="@completionRate.ToString("0.##", CultureInfo.InvariantCulture)" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: @completionRate.ToString("0.##", CultureInfo.InvariantCulture)%"></div>
        </div>
        @if (Model.ProgressSummary is not null)
        {
            <p class="text-muted mb-0">@T.F("Updated {0}", Model.ProgressSummary.CalculatedAtUtc.LocalDateTime.ToString("d MMM yyyy, HH:mm", Translator.FormatCulture))</p>
        }
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
