@model AdminRegimensIndexViewModel
@{
    ViewData["Title"] = T["Diet Regimens"];
}

<section class="page-head">
    <div>
        <p class="eyebrow">@T["Admin workspace"]</p>
        <h1>@T["Manage diet regimens"]</h1>
        <p class="text-muted mb-0">@T["A regimen is a named eating pattern from the book: guideline rules plus meals scheduled by day. Members only see approved, active regimens."]</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="AdminKnowledge" asp-action="Index"><span class="icon" aria-hidden="true">arrow_back</span>@T["Back to admin"]</a>
</section>

<section class="two-pane">
    <form asp-action="Create" method="post" class="section-card form-stack">
        <div class="card-heading">
            <h2><span class="icon" aria-hidden="true">add_circle</span>@T["New regimen"]</h2>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
        <div>
            <label asp-for="Form.Name" class="form-label"></label>
            <input asp-for="Form.Name" class="form-control" />
            <span asp-validation-for="Form.Name" class="text-danger small"></span>
        </div>
        <div>
            <label asp-for="Form.Description" class="form-label"></label>
            <textarea asp-for="Form.Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Form.Description" class="text-danger small"></span>
        </div>
        <div>
            <label asp-for="Form.DurationDays" class="form-label"></label>
            <input asp-for="Form.DurationDays" type="number" min="1" max="365" class="form-control" />
            <span asp-validation-for="Form.DurationDays" class="text-danger small"></span>
        </div>
        <div>
            <label asp-for="Form.SourceChapter" class="form-label"></label>
            <input asp-for="Form.SourceChapter" class="form-control" />
        </div>
        <div>
            <label asp-for="Form.SourcePage" class="form-label"></label>
            <input asp-for="Form.SourcePage" class="form-control" />
        </div>
        <div>
            <label asp-for="Form.ReviewStatus" class="form-label"></label>
            <select asp-for="Form.ReviewStatus" class="form-select">
                <option value="NeedsReview">@T["NeedsReview"]</option>
                <option value="Approved">@T["Approved"]</option>
            </select>
        </div>
        <button class="btn btn-dark" type="submit">@T["Create regimen"]</button>
    </form>

    <div class="section-card">
        <div class="card-heading">
            <h2><span class="icon" aria-hidden="true">calendar_month</span>@T["Regimens"]</h2>
            <span class="count-pill">@Model.Regimens.TotalCount</span>
        </div>
        @if (Model.Regimens.Items.Count == 0)
        {
            <p class="empty-state">@T["No diet regimens yet."]</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>@T["Name"]</th>
                            <th>@T["Days"]</th>
                            <th>@T["Review status"]</th>
                            <th>@T["Status"]</th>
                            <th class="table-actions">@T["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Regimens.Items)
                        {
                            <tr>
                                <td>@T.C(item.Name)<div class="text-muted small">@T.F("{0} planned meals", item.Meals.Count) · @T.F("{0} guidelines", item.Guidelines.Count)</div></td>
                                <td>@item.DurationDays</td>
                                <td>@T[item.ReviewStatus]</td>
                                <td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? T["Active"] : T["Inactive"])</span></td>
                                <td class="table-actions">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">@T["Edit"]</a>
                                    <form asp-action="SetActivation" method="post" class="inline-form">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="isActive" value="@(!item.IsActive)" />
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">@(item.IsActive ? T["Deactivate"] : T["Activate"])</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_Pager", PagerViewModel.For(Model.Regimens, "page", ""))
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
