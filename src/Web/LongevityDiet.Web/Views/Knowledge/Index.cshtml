@model KnowledgeIndexViewModel
@{
    ViewData["Title"] = T["Knowledge"];
}

<section class="page-head">
    <div>
        <p class="eyebrow">@T["Approved content"]</p>
        <h1>@T["Diet knowledge"]</h1>
        <p class="text-muted mb-0">@T["Search book-derived guidelines, foods, and recipes used by planning and recommendation flows."]</p>
    </div>
</section>

<form method="get" class="filter-bar">
    <div>
        <label asp-for="Search" class="form-label">@T["Search"]</label>
        <input asp-for="Search" class="form-control" placeholder="@T["guideline, food, recipe"]" />
    </div>
    <div>
        <label asp-for="Category" class="form-label">@T["Food category"]</label>
        <input asp-for="Category" class="form-control" placeholder="@T["legume, grain, vegetable"]" />
    </div>
    <div class="filter-actions">
        <button class="btn btn-dark" type="submit">@T["Apply"]</button>
        <a class="btn btn-outline-secondary" asp-action="Index">@T["Reset"]</a>
    </div>
</form>

<section class="content-grid three-columns">
    <div class="section-card">
        <div class="card-heading">
            <h2>@T["Guidelines"]</h2>
            <span class="count-pill">@Model.Guidelines.TotalCount</span>
        </div>
        <div class="item-stack">
            @foreach (var guideline in Model.Guidelines.Items)
            {
                <article class="content-item">
                    <div class="item-title">@T.C(guideline.Title)</div>
                    <p>@T.C(guideline.Summary)</p>
                    <small>@T.C(guideline.SourceChapter) @guideline.SourcePage</small>
                </article>
            }
            @if (!Model.Guidelines.Items.Any())
            {
                <p class="empty-state">@T["No guidelines found."]</p>
            }
        </div>
    </div>

    <div class="section-card">
        <div class="card-heading">
            <h2>@T["Foods"]</h2>
            <span class="count-pill">@Model.Foods.TotalCount</span>
        </div>
        <div class="item-stack">
            @foreach (var food in Model.Foods.Items)
            {
                <article class="content-item">
                    <div class="item-title">@T.C(food.Name)</div>
                    <span class="badge text-bg-light border">@T.C(food.Category)</span>
                    <p>@T.C(food.CompatibilityNotes)</p>
                </article>
            }
            @if (!Model.Foods.Items.Any())
            {
                <p class="empty-state">@T["No foods found."]</p>
            }
        </div>
    </div>

    <div class="section-card">
        <div class="card-heading">
            <h2>@T["Recipes"]</h2>
            <span class="count-pill">@Model.Recipes.TotalCount</span>
        </div>
        <div class="item-stack">
            @foreach (var recipe in Model.Recipes.Items)
            {
                <article class="content-item">
                    <div class="item-title">@T.C(recipe.Name)</div>
                    <p>@T.C(recipe.Description)</p>
                    @if (recipe.Ingredients.Any())
                    {
                        <small>@string.Join(", ", recipe.Ingredients.Select(i => $"{T.Q(i.QuantityText)} {(Translator.IsVietnamese ? T.C(i.FoodName).ToLowerInvariant() : T.C(i.FoodName))}"))</small>
                    }
                </article>
            }
            @if (!Model.Recipes.Items.Any())
            {
                <p class="empty-state">@T["No recipes found."]</p>
            }
        </div>
    </div>
</section>
