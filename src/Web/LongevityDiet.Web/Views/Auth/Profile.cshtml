@model UserProfileResponse
@{
    ViewData["Title"] = T["Profile"];
}

<section class="page-head">
    <div>
        <p class="eyebrow">@T["Signed-in user"]</p>
        <h1>@T["Profile"]</h1>
        <p class="text-muted mb-0">@T["Identity data comes from the Identity Service through the API Gateway."]</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">@T["Back to dashboard"]</a>
</section>

<section class="section-card narrow-card">
    <dl class="detail-list">
        <dt>@T["Name"]</dt>
        <dd>@Model.DisplayName</dd>
        <dt>@T["Email"]</dt>
        <dd>@Model.Email</dd>
        <dt>@T["Status"]</dt>
        <dd>
            <span class="badge @(Model.IsActive ? "text-bg-success" : "text-bg-secondary")">
                @(Model.IsActive ? T["Active"] : T["Inactive"])
            </span>
        </dd>
        <dt>@T["Roles"]</dt>
        <dd>@string.Join(", ", Model.Roles.Select(role => T[role]))</dd>
        <dt>@T["Created"]</dt>
        <dd>@Model.CreatedAtUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>
</section>
