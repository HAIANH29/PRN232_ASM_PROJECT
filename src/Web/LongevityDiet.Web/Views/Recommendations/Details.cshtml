@model RecommendationDetailsViewModel
@{
    ViewData["Title"] = T["Your meal ideas"];
    var status = Model.Request.Status;
    var isPending = string.Equals(status, "Pending", StringComparison.OrdinalIgnoreCase);
    var canAccept = string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase)
        && Model.Request.AcceptedMealPlanId is null;
    var slots = new[] { "Breakfast", "Lunch", "Dinner", "Snack" };
}

<section class="page-head">
    <div>
        <p class="eyebrow">@T["Meal ideas"]</p>
        <h1>@(isPending ? T["Preparing your meal ideas..."] : canAccept ? T["Your meal ideas are ready"] : T["Your meal ideas"])</h1>
        <p class="text-muted mb-0">
            @T.F(Model.Request.Days == 1 ? "{0} meal idea" : "{0} meal ideas", Model.Request.Days)@(Model.Request.PreferenceTags.Any() ? T[" for: "] + string.Join(", ", Model.Request.PreferenceTags) : "")
        </p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">@T["All requests"]</a>
</section>

@if (isPending)
{
    <section class="section-card pending-card" data-auto-refresh="3000">
        <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
        <div>
            <strong>@T["Working on it"]</strong>
            <small>@T["This page refreshes by itself. It usually takes a few seconds."]</small>
        </div>
    </section>
}
else if (Model.Request.AcceptedMealPlanId.HasValue)
{
    <section class="section-card">
        <div class="card-heading"><h2>@T["Already added to a plan"]</h2></div>
        <p class="text-muted">@T["You turned these ideas into a meal plan."]</p>
        <ul class="idea-list">
            @foreach (var title in Model.Request.SuggestedMealTitles)
            {
                <li>@T.C(title)</li>
            }
        </ul>
        <a class="btn btn-dark" asp-controller="MealPlans" asp-action="Details" asp-route-id="@Model.Request.AcceptedMealPlanId">@T["Open my meal plan"]</a>
    </section>
}
else if (!Model.Request.SuggestedMealTitles.Any())
{
    <section class="section-card">
        <p class="empty-state">@T["No ideas were produced for this request. Try again with different preferences."]</p>
    </section>
}
else
{
    <form asp-action="Accept" asp-route-id="@Model.Request.Id" method="post" class="section-card form-stack">
        <div class="card-heading">
            <h2>@T["Choose what goes into your plan"]</h2>
        </div>
        <p class="text-muted mb-0">@T["Untick any idea you do not want. For each one, pick the day, the meal, and the matching recipe or food from our catalog so it can be tracked later."]</p>
        <div asp-validation-summary="All" class="text-danger small"></div>

        <div>
            <label asp-for="AcceptForm.Name" class="form-label"></label>
            <input asp-for="AcceptForm.Name" class="form-control" />
            <span asp-validation-for="AcceptForm.Name" class="text-danger small"></span>
        </div>

        <div class="meal-rows">
            @for (var i = 0; i < Model.AcceptForm.Meals.Count; i++)
            {
                <div class="meal-row">
                    <div class="meal-row-title">
                        <label class="form-check">
                            <input asp-for="AcceptForm.Meals[i].Include" class="form-check-input" />
                            <span class="form-check-label"><strong>@T.C(Model.AcceptForm.Meals[i].Title)</strong></span>
                        </label>
                        <input asp-for="AcceptForm.Meals[i].Title" type="hidden" />
                    </div>
                    <div class="meal-row-fields">
                        <div>
                            <label asp-for="AcceptForm.Meals[i].PlannedDate" class="form-label small">@T["Day"]</label>
                            <input asp-for="AcceptForm.Meals[i].PlannedDate" type="date" class="form-control" />
                        </div>
                        <div>
                            <label asp-for="AcceptForm.Meals[i].MealSlot" class="form-label small">@T["Meal"]</label>
                            <select asp-for="AcceptForm.Meals[i].MealSlot" class="form-select">
                                @foreach (var slot in slots)
                                {
                                    <option value="@slot" selected="@(Model.AcceptForm.Meals[i].MealSlot == slot)">@T[slot]</option>
                                }
                            </select>
                        </div>
                        <div class="meal-row-wide">
                            <label asp-for="AcceptForm.Meals[i].Choice" class="form-label small">@T["Recipe or food"]</label>
                            <select asp-for="AcceptForm.Meals[i].Choice" class="form-select">
                                <option value="">@T["Choose from catalog..."]</option>
                                <optgroup label="Recipes">
                                    @foreach (var recipe in Model.Recipes)
                                    {
                                        var value = $"recipe:{recipe.Id}";
                                        <option value="@value" selected="@(Model.AcceptForm.Meals[i].Choice == value)">@T.C(recipe.Name)</option>
                                    }
                                </optgroup>
                                <optgroup label="Single foods">
                                    @foreach (var food in Model.Foods)
                                    {
                                        var value = $"food:{food.Id}";
                                        <option value="@value" selected="@(Model.AcceptForm.Meals[i].Choice == value)">@T.C(food.Name) (@T.C(food.Category))</option>
                                    }
                                </optgroup>
                            </select>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="form-actions">
            <button class="btn btn-dark" type="submit">@T["Create my meal plan"]</button>
            <small class="text-muted">@T["The plan's dates are set from the days you choose above."]</small>
        </div>
    </form>
}

@if (!string.IsNullOrWhiteSpace(Model.Request.Disclaimer))
{
    <p class="note-box mt-3">@T.C(Model.Request.Disclaimer)</p>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
