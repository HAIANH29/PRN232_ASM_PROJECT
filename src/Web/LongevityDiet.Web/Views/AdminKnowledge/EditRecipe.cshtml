@model RecipeForm
@{
    ViewData["Title"] = T["Edit recipe"];
    var foods = ViewBag.Foods as IReadOnlyCollection<FoodResponse> ?? Array.Empty<FoodResponse>();
}

<section class="page-head">
    <div>
        <p class="eyebrow">@T["Admin edit"]</p>
        <h1>@T["Edit recipe"]</h1>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">@T["Back to admin"]</a>
</section>

<form asp-action="EditRecipe" asp-route-id="@Model.Id" method="post" class="section-card form-grid">
    <div asp-validation-summary="All" class="text-danger small grid-full"></div>
    <div>
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div>
        <label asp-for="ReviewStatus" class="form-label"></label>
        <select asp-for="ReviewStatus" class="form-select">
            <option value="NeedsReview">@T["NeedsReview"]</option>
            <option value="Approved">@T["Approved"]</option>
        </select>
    </div>
    <div class="grid-full">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
    <div>
        <label asp-for="IngredientFoodId" class="form-label">@T["Ingredient"]</label>
        <select asp-for="IngredientFoodId" class="form-select">
            <option value="@Guid.Empty">@T["Choose approved food"]</option>
            @foreach (var food in foods)
            {
                <option value="@food.Id">@T.C(food.Name) (@T.C(food.Category))</option>
            }
        </select>
        <span asp-validation-for="IngredientFoodId" class="text-danger small"></span>
    </div>
    <div>
        <label asp-for="IngredientQuantityText" class="form-label">@T["Quantity"]</label>
        <input asp-for="IngredientQuantityText" class="form-control" />
    </div>
    <div>
        <label asp-for="SourceChapter" class="form-label"></label>
        <input asp-for="SourceChapter" class="form-control" />
    </div>
    <div>
        <label asp-for="SourcePage" class="form-label"></label>
        <input asp-for="SourcePage" class="form-control" />
    </div>
    <div class="grid-full">
        <label asp-for="SourceReference" class="form-label"></label>
        <input asp-for="SourceReference" class="form-control" />
    </div>
    <div>
        <label asp-for="ReviewedBy" class="form-label"></label>
        <input asp-for="ReviewedBy" class="form-control" />
    </div>
    <div>
        <label asp-for="Category" class="form-label">@T["Category (optional)"]</label>
        <input asp-for="Category" class="form-control" />
    </div>
    <div class="grid-full form-actions">
        <button class="btn btn-dark" type="submit">@T["Save changes"]</button>
    </div>
</form>

@{
    var steps = (ViewBag.Steps as IReadOnlyCollection<RecipeStepResponse> ?? Array.Empty<RecipeStepResponse>())
        .OrderBy(step => step.StepNumber)
        .ToList();
}
<section class="section-card mt-3">
    <div class="card-heading">
        <h2><span class="icon" aria-hidden="true">format_list_numbered</span>@T["Preparation steps"]</h2>
        <span class="count-pill">@steps.Count</span>
    </div>
    @if (steps.Count == 0)
    {
        <p class="empty-state">@T["No steps yet."]</p>
    }
    else
    {
        <ol class="list-unstyled mb-3">
            @foreach (var step in steps)
            {
                <li class="d-flex justify-content-between align-items-start border-bottom py-2 gap-2">
                    <span><strong>@step.StepNumber.</strong> @T.C(step.Instruction)</span>
                    <form asp-action="RemoveRecipeStep" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="stepNumber" value="@step.StepNumber" />
                        <button class="btn btn-sm btn-outline-danger" type="submit">@T["Remove"]</button>
                    </form>
                </li>
            }
        </ol>
    }
    <form asp-action="AddRecipeStep" asp-route-id="@Model.Id" method="post" class="filter-bar">
        <div>
            <label for="stepNumber" class="form-label">@T["Step number"]</label>
            <input id="stepNumber" name="StepNumber" type="number" min="1" class="form-control" value="@(steps.Count + 1)" />
        </div>
        <div class="grow">
            <label for="stepInstruction" class="form-label">@T["Instruction"]</label>
            <input id="stepInstruction" name="Instruction" class="form-control" maxlength="2000" required />
        </div>
        <div class="filter-actions">
            <button class="btn btn-dark" type="submit">@T["Add step"]</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
