@model AdminBookSourceDetailsViewModel
@{
    ViewData["Title"] = T["Book Source Details"];
}

<section class="page-head" id="book-source-head">
    <div>
        <p class="eyebrow">@T["Book source"]</p>
        <h1>@Model.Document.OriginalFileName</h1>
        <p class="text-muted mb-0">@T["Review extracted chunks, generate candidates, then approve only the items that are safe and source-verified."]</p>
    </div>
    <div class="head-actions">
        <a class="btn btn-outline-secondary" asp-action="Index"><span class="icon" aria-hidden="true">arrow_back</span>@T["Back to sources"]</a>
        <form asp-action="GenerateCandidates" asp-route-id="@Model.Document.Id" method="post" class="inline-form" data-fetch="section"
              data-progress-url="@Url.Action("GenerationStatus", new { id = Model.Document.Id })"
              data-progress-label="@T["Generating candidates"]">
            <button class="btn btn-dark" type="submit" disabled="@(Model.Document.Status != "Chunked" || Model.Progress.RemainingChunks == 0)"><span class="icon" aria-hidden="true">auto_awesome</span>@(Model.Progress.ProcessedChunks == 0 ? T["Generate candidates"] : T["Generate next batch"])</button>
        </form>
        <form asp-action="ApproveAllCandidates" asp-route-id="@Model.Document.Id" method="post" class="inline-form" data-fetch="section"
              onsubmit="return confirm('@T["Approve every pending candidate without disease or treatment wording? Placeholders and flagged items stay for manual review."]');">
            <button class="btn btn-success" type="submit" disabled="@(!Model.Candidates.Any(candidate => candidate.Status == "NeedsReview"))"><span class="icon" aria-hidden="true">done_all</span>@T["Approve all"]</button>
        </form>
        <form asp-action="RejectPlaceholders" asp-route-id="@Model.Document.Id" method="post" class="inline-form" data-fetch="section"
              onsubmit="return confirm('@T["Reject every placeholder draft that has no real summary?"]');">
            <button class="btn btn-outline-secondary" type="submit" disabled="@(!Model.Candidates.Any(candidate => candidate.Status == "NeedsReview" && candidate.GeneratedBy == "LocalChunkFallback"))"><span class="icon" aria-hidden="true">delete_sweep</span>@T["Reject placeholders"]</button>
        </form>
        <form asp-action="Delete" asp-route-id="@Model.Document.Id" method="post" class="inline-form"
              onsubmit="return confirm('@T["Delete this book source with its chunks and candidates? Knowledge already approved from it is kept."]');">
            <button class="btn btn-outline-danger" type="submit">@T["Delete"]</button>
        </form>
    </div>
</section>

<section class="content-grid two-columns">
    <div class="section-card">
        <div class="card-heading">
            <h2><span class="icon" aria-hidden="true">description</span>@T["Document"]</h2>
            <span class="badge @(Model.Document.Status == "Failed" ? "text-bg-danger" : Model.Document.Status == "Chunked" ? "text-bg-success" : "text-bg-secondary")">@T[Model.Document.Status]</span>
        </div>
        <dl class="detail-list">
            <dt>@T["Uploaded by"]</dt>
            <dd>@Model.Document.UploadedBy</dd>
            <dt>@T["Uploaded at"]</dt>
            <dd>@Model.Document.UploadedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
            <dt>@T["Processed at"]</dt>
            <dd>@(Model.Document.ProcessedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
            <dt>@T["Chunks"]</dt>
            <dd>@Model.Document.ChunkCount</dd>
            <dt>@T["Stored file"]</dt>
            <dd>@Model.Document.StoredFileName</dd>
        </dl>
        @if (!string.IsNullOrWhiteSpace(Model.Document.ErrorMessage))
        {
            <div class="site-alert error mt-3 mb-0"><span class="icon" aria-hidden="true">error</span><span class="site-alert-text">@Model.Document.ErrorMessage</span></div>
        }
    </div>

    <div class="section-card">
        <div class="card-heading">
            <h2><span class="icon" aria-hidden="true">shield</span>@T["Review rule"]</h2>
        </div>
        <p class="text-muted mb-0">@T["Candidates are not visible to users and are not used by recommendations until an Admin approves them into managed Diet Knowledge content."]</p>
    </div>
</section>

<section class="section-card mt-3" id="candidates-section">
    <div class="card-heading">
        <h2><span class="icon" aria-hidden="true">rule</span>@T["Knowledge candidates"]</h2>
        <span class="count-pill">@Model.Candidates.Count</span>
    </div>
    @if (Model.Progress.RelevantChunks > 0)
    {
        var percent = (int)Math.Round(100.0 * Model.Progress.ProcessedChunks / Model.Progress.RelevantChunks);
        <div class="mb-3">
            <div class="progress" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: @percent%"></div>
            </div>
            <small class="text-muted">
                @T.F("Analyzed {0} of {1} relevant chunks ({2} skipped as boilerplate or out of scope).", Model.Progress.ProcessedChunks, Model.Progress.RelevantChunks, Model.Progress.SkippedChunks)
                @if (Model.Progress.RemainingChunks > 0)
                {
                    <span>@T["Press the button to analyze the next batch."]</span>
                }
                else
                {
                    <span>@T["The whole document has been analyzed."]</span>
                }
            </small>
        </div>
    }
    @if (!Model.Candidates.Any())
    {
        <p class="empty-state">@T["No candidates yet. Generate candidates after the document is chunked."]</p>
    }
    else
    {
        <div class="item-stack">
            @foreach (var candidate in Model.Candidates)
            {
                <article class="content-item" id="candidate-@candidate.Id">
                    <div class="candidate-head">
                        <div>
                            <div class="item-title">@T.C(candidate.Title)</div>
                            <div class="chip-row">
                                <span class="chip-tag">@T[candidate.CandidateType]</span>
                                <span class="chip-tag neutral"><span class="icon" aria-hidden="true">auto_awesome</span>@candidate.GeneratedBy</span>
                                <span class="chip-tag js-status-chip @(candidate.Status == "NeedsReview" ? "warning" : candidate.Status == "Approved" ? "success" : "danger")">@T[candidate.Status]</span>
                            </div>
                        </div>
                        @if (candidate.Status == "NeedsReview")
                        {
                            <div class="row-actions">
                                <form asp-action="ApproveCandidate" method="post" class="inline-form" data-fetch="item">
                                    <input type="hidden" name="documentId" value="@Model.Document.Id" />
                                    <input type="hidden" name="candidateId" value="@candidate.Id" />
                                    <button class="btn btn-sm btn-dark" type="submit"><span class="icon" aria-hidden="true">check</span>@T["Approve"]</button>
                                </form>
                                <form asp-action="RejectCandidate" method="post" class="inline-form" data-fetch="item">
                                    <input type="hidden" name="documentId" value="@Model.Document.Id" />
                                    <input type="hidden" name="candidateId" value="@candidate.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit"><span class="icon" aria-hidden="true">close</span>@T["Reject"]</button>
                                </form>
                            </div>
                        }
                    </div>
                    <p>@T.C(candidate.Summary)</p>
                    <small>@T.C(candidate.SourceTitle) · @T.C(candidate.SourceChapter) · @T.F("page {0}", candidate.SourcePage) · @T.C(candidate.SourceReference)</small>
                </article>
            }
        </div>
    }
</section>

<section class="section-card mt-3">
    <div class="card-heading">
        <h2><span class="icon" aria-hidden="true">segment</span>@T["Extracted chunks"]</h2>
        <span class="count-pill">@Model.Chunks.Count</span>
    </div>
    @if (!Model.Chunks.Any())
    {
        <p class="empty-state">@T["No extracted chunks available."]</p>
    }
    else
    {
        <div class="item-stack">
            @foreach (var chunk in Model.Chunks)
            {
                <details class="content-item">
                    <summary class="item-title">@T.F("Chunk {0} · page {1} · {2} chars", chunk.ChunkIndex, chunk.PageNumber, chunk.CharacterCount)</summary>
                    <p class="chunk-text">@Shorten(chunk.Text, 1800)</p>
                </details>
            }
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/book-candidates.js" asp-append-version="true"></script>
}

@functions {
    private static string Shorten(string value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length <= maxLength)
        {
            return value;
        }

        return $"{value[..maxLength]}...";
    }
}
