{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity"
          }
        ]
      },
      "diet-knowledge": {
        "ClusterId": "diet-knowledge",
        "Match": {
          "Path": "/diet-knowledge/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/diet-knowledge"
          }
        ]
      },
      "meal-planning": {
        "ClusterId": "meal-planning",
        "Match": {
          "Path": "/meal-planning/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/meal-planning"
          }
        ]
      },
      "tracking": {
        "ClusterId": "tracking",
        "Match": {
          "Path": "/tracking/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/tracking"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity-api": {
            "Address": "http://identity-service:8080/"
          }
        }
      },
      "diet-knowledge": {
        "Destinations": {
          "diet-knowledge-api": {
            "Address": "http://diet-knowledge-service:8080/"
          }
        }
      },
      "meal-planning": {
        "Destinations": {
          "meal-planning-api": {
            "Address": "http://meal-planning-service:8080/"
          }
        }
      },
      "tracking": {
        "Destinations": {
          "tracking-api": {
            "Address": "http://tracking-service:8080/"
          }
        }
      }
    }
  }
}
