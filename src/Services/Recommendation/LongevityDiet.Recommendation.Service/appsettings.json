{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "RecommendationExchange": "longevity.recommendations",
    "RecommendationRequestQueue": "recommendation.requests",
    "RecommendationRequestRoutingKey": "recommendation.requested",
    "RecommendationResultQueue": "recommendation.results",
    "RecommendationResultRoutingKey": "recommendation.completed",
    "MaxDeliveryAttempts": 3,
    "RetryDelaySeconds": 5,
    "ConsumerPrefetchCount": 4
  },
  "DietKnowledgeService": {
    "BaseUrl": "http://diet-knowledge-service:8080"
  },
  "Gemini": {
    "Enabled": false,
    "Endpoint": "https://generativelanguage.googleapis.com",
    "ApiKey": "development-only",
    "Model": "gemini-2.0-flash",
    "TimeoutSeconds": 30,
    "Temperature": 0.2,
    "MaxOutputTokens": 512
  }
}
