{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DietKnowledgeDb": "Host=diet-knowledge-db;Port=5432;Database=DietKnowledgeDb;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "LongevityDiet.Identity",
    "Audience": "LongevityDiet.Platform"
  },
  "DietKnowledgeSeed": {
    "IncludeDemoApprovedContent": true
  },
  "BookKnowledgeIngestion": {
    "StoragePath": "storage/book-sources",
    "MaxChunkCharacters": 2500,
    "ChunkOverlapCharacters": 200,
    "MaxChunksPerGeneration": 8
  },
  "Gemini": {
    "Enabled": false,
    "Endpoint": "https://generativelanguage.googleapis.com",
    "ApiKey": "development-only",
    "Model": "gemini-2.0-flash"
  }
}
