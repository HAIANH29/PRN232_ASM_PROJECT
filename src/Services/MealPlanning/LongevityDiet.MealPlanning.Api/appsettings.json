{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MealPlanningDb": "Host=meal-planning-db;Port=5432;Database=MealPlanningDb;Username=postgres;Password=postgres"
  },
  "DietKnowledgeService": {
    "BaseUrl": "http://diet-knowledge-service:8080"
  },
  "Jwt": {
    "Issuer": "LongevityDiet.Identity",
    "Audience": "LongevityDiet.Platform"
  },
  "RabbitMq": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ReminderExchange": "longevity.reminders",
    "ReminderQueue": "reminder.requests",
    "ReminderRoutingKey": "reminder.requested",
    "RecommendationExchange": "longevity.recommendations",
    "RecommendationRequestQueue": "recommendation.requests",
    "RecommendationRequestRoutingKey": "recommendation.requested",
    "RecommendationResultQueue": "recommendation.results",
    "RecommendationResultRoutingKey": "recommendation.completed"
  }
}
